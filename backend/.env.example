NODE_ENV=development
PORT=8000
APP_NAME=MotorCenter
# MONGODB_URI is a PLACEHOLDER by default (dummy DB). Replace it with a real
# Atlas string to connect, e.g.:
#   mongodb+srv://user:pass@cluster.xxxx.mongodb.net/motorcenter_phase3
# then run: cd backend && pnpm run seed && pnpm run dev. See ../SETUP.md.
# Never commit real credentials. Do NOT change the app default to in-memory.
MONGODB_URI=YOUR_ATLAS_CONNECTION_STRING
JWT_SECRET=YOUR_SECRET_AT_LEAST_8_CHARACTERS
JWT_EXPIRES_IN=1d
CORS_ORIGIN=*

# Optional: set all four together for real delivery; otherwise Ethereal preview is used.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
